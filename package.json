{
  "name": "aurora-intel",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:ai": "node scripts/dev-runner.mjs --ai",
    "dev:server": "node --watch server/index.mjs",
    "build": "npm run build:web",
    "build:web": "npm --prefix web run build",
    "db:migrate": "node server/cli.mjs migrate",
    "db:seed": "node server/cli.mjs seed",
    "self-test": "node server/cli.mjs self-test",
    "backup": "node server/cli.mjs backup",
    "start": "node server/index.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:licenses": "node tests/license-guard.mjs",
    "test:offline": "node tests/offline-guard.mjs web/dist",
    "check": "npm run build && npm test && npm run test:offline && npm run test:licenses"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "i18next": "25.10.10",
    "maplibre-gl": "6.2.0",
    "mgrs": "2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
